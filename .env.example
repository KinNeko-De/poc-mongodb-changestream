# Environment variables for MongoDB Change Stream PoC
# Copy this file to .env and modify as needed

# MongoDB connection string for local development with Docker
MONGO_URI=mongodb://admin:password123@localhost:27017/changestream_poc?authSource=admin&replicaSet=rs0

# Alternative connection strings (comment/uncomment as needed):

# For local MongoDB without authentication:
# MONGO_URI=mongodb://localhost:27017

# For MongoDB Atlas or remote instance:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/changestream_poc?retryWrites=true&w=majority

# For containerized applications (when running apps in Docker):
# MONGO_URI=mongodb://admin:password123@mongodb:27017/changestream_poc?authSource=admin&replicaSet=rs0
